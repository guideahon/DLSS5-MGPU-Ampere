+void ProbePrivateHeapFd(FeatureState& state) {
+  if (!TransportFdProbeEnabled() || state.transport_probe_done ||
+      !device || !state.private_heap || state.private_heap_size == 0) {
+    return;
+  }
+  state.transport_probe_done = true;
+
+  Vkd3dInterop4* interop = nullptr;
+  const HRESULT query = device->QueryInterface(
+      kVkd3dInteropDevice4, reinterpret_cast<void**>(&interop));
+  if (FAILED(query) || interop == nullptr) {
+    Log("fd_probe query_interop4 hr=0x%08x", query);
+    return;
+  }
+  const char* helper_path = std::getenv("MGPU_CUDA_IMPORT_HELPER");
+  const char* image_helper_path = std::getenv("MGPU_VULKAN_IMAGE_IMPORT_HELPER");
+  HMODULE ntdll = GetModuleHandleA("ntdll.dll");
+  auto spawn = ntdll == nullptr ? nullptr
+      : reinterpret_cast<WineUnixSpawnvp>(GetProcAddress(ntdll, "__wine_unix_spawnvp"));
+  if ((helper_path == nullptr || *helper_path == '\0') &&
+      (image_helper_path == nullptr || *image_helper_path == '\0')) {
+    Log("fd_probe unavailable helper=%s image_helper=%s spawn=%p",
+        helper_path ? helper_path : "", image_helper_path ? image_helper_path : "", spawn);
+    interop->lpVtbl->Release(reinterpret_cast<Vkd3dInteropDevice*>(interop));
+    return;
+  }
+  if (spawn == nullptr) {
+    Log("fd_probe unavailable: __wine_unix_spawnvp is missing");
+    interop->lpVtbl->Release(reinterpret_cast<Vkd3dInteropDevice*>(interop));
+    return;
+  }
+
+  SetEnvironmentVariableA("VKD3D_EXPORT_HEAP_FD", "1");
+  int fd = -1;
+  const HRESULT export_result = interop->lpVtbl->ExportVulkanHeapFd(
+      reinterpret_cast<Vkd3dInteropDevice*>(interop), state.private_heap.Get(), 1U, &fd);
+  Log("fd_probe export hr=0x%08x fd=%d size=%llu", export_result, fd,
+      static_cast<unsigned long long>(state.private_heap_size));
+  if (SUCCEEDED(export_result) && fd >= 0) {
+    char fd_text[32];
+    char size_text[32];
+    char* end = nullptr;
+    const char* source_value = std::getenv("MGPU_CUDA_SOURCE_ORDINAL");
+    const char* destination_value = std::getenv("MGPU_CUDA_DESTINATION_ORDINAL");
+    const int source = source_value ? static_cast<int>(std::strtol(source_value, &end, 10)) : 0;
+    end = nullptr;
+    const int destination = destination_value
+        ? static_cast<int>(std::strtol(destination_value, &end, 10)) : 1;
+    std::snprintf(fd_text, sizeof(fd_text), "%d", fd);
+    std::snprintf(size_text, sizeof(size_text), "%llu",
+                  static_cast<unsigned long long>(state.private_heap_size));
+    char source_text[16];
+    char destination_text[16];
+    std::snprintf(source_text, sizeof(source_text), "%d", source);
+    std::snprintf(destination_text, sizeof(destination_text), "%d", destination);
+    if (image_helper_path != nullptr && *image_helper_path != '\0') {
+      const D3D12_RESOURCE_DESC image_desc = state.private_output->GetDesc();
+      UINT64 image_handle = 0;
+      UINT64 image_offset = 0;
+      int image_layout = 0;
+      HRESULT image_info_result = interop->lpVtbl->GetVulkanResourceInfo1(
+          reinterpret_cast<Vkd3dInteropDevice*>(interop), state.private_output.Get(),
+          &image_handle, &image_offset, &image_layout);
+      Log("image_probe resource_info hr=0x%08x handle=0x%llx offset=%llu layout=%d",
+          image_info_result, static_cast<unsigned long long>(image_handle),
+          static_cast<unsigned long long>(image_offset), image_layout);
+      if (SUCCEEDED(image_info_result) && image_handle != 0) {
+        char width_text[16];
+        char height_text[16];
+        char format_text[16];
+        char offset_text[32];
+        std::snprintf(width_text, sizeof(width_text), "%u", image_desc.Width > UINT32_MAX
+                      ? UINT32_MAX : static_cast<UINT32>(image_desc.Width));
+        std::snprintf(height_text, sizeof(height_text), "%u", image_desc.Height);
+        std::snprintf(format_text, sizeof(format_text), "%u",
+                      static_cast<unsigned int>(image_desc.Format));
+        std::snprintf(offset_text, sizeof(offset_text), "%llu",
+                      static_cast<unsigned long long>(image_offset));
+        char* image_argv[] = {const_cast<char*>(image_helper_path), fd_text, size_text,
+                              destination_text, width_text, height_text, format_text,
+                              offset_text, nullptr};
+        SetEnvironmentVariableA("MGPU_INHERIT_FD", fd_text);
+        const LONG image_spawn_result = spawn(image_argv, 1);
+        SetEnvironmentVariableA("MGPU_INHERIT_FD", nullptr);
+        Log("image_probe helper=%s spawn_rc=%ld destination=%d", image_helper_path,
+            static_cast<long>(image_spawn_result), destination);
+      }
+    }
+    if (helper_path != nullptr && *helper_path != '\0') {
+      char* argv[] = {const_cast<char*>(helper_path), fd_text, size_text,
+                      source_text, destination_text, nullptr};
+      SetEnvironmentVariableA("MGPU_INHERIT_FD", fd_text);
+      const LONG spawn_result = spawn(argv, 1);
+      SetEnvironmentVariableA("MGPU_INHERIT_FD", nullptr);
+      Log("fd_probe helper=%s spawn_rc=%ld source=%d destination=%d", helper_path,
+          static_cast<long>(spawn_result), source, destination);
+    }
+  }
+  interop->lpVtbl->Release(reinterpret_cast<Vkd3dInteropDevice*>(interop));
+  SetEnvironmentVariableA("VKD3D_EXPORT_HEAP_FD", nullptr);
+}
