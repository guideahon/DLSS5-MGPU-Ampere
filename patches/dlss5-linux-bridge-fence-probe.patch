+void ProbeFenceFd(FeatureState& state) {
+  if (!TransportFdProbeEnabled() || state.fence_probe_done || !device)
+    return;
+  state.fence_probe_done = true;
+
+  Vkd3dInterop5* interop = nullptr;
+  const HRESULT query = device->QueryInterface(
+      kVkd3dInteropDevice5, reinterpret_cast<void**>(&interop));
+  if (FAILED(query) || interop == nullptr) {
+    Log("fence_probe query_interop5 hr=0x%08x", query);
+    return;
+  }
+  ComPtr<ID3D12Fence> fence;
+  const HRESULT create_result = device->CreateFence(
+      0, D3D12_FENCE_FLAG_SHARED, IID_PPV_ARGS(&fence));
+  if (FAILED(create_result)) {
+    Log("fence_probe create hr=0x%08x", create_result);
+    interop->lpVtbl->Release(reinterpret_cast<Vkd3dInteropDevice*>(interop));
+    return;
+  }
+  SetEnvironmentVariableA("VKD3D_EXPORT_FENCE_FD", "1");
+  int fd = -1;
+  const HRESULT export_result = interop->lpVtbl->ExportVulkanFenceFd(
+      reinterpret_cast<Vkd3dInteropDevice*>(interop), fence.Get(), 1U, &fd);
+  Log("fence_probe export hr=0x%08x fd=%d", export_result, fd);
+  interop->lpVtbl->Release(reinterpret_cast<Vkd3dInteropDevice*>(interop));
+  SetEnvironmentVariableA("VKD3D_EXPORT_FENCE_FD", nullptr);
+}
