+static HRESULT STDMETHODCALLTYPE d3d12_dxvk_interop_device_GetVulkanPhysicalDeviceIdentity(
+        d3d12_dxvk_interop_device_iface *iface, UINT8 *device_uuid, UINT32 *domain,
+        UINT32 *bus, UINT32 *device_id, UINT32 *function)
+{
+    struct d3d12_device *device = d3d12_device_from_ID3D12DXVKInteropDevice(iface);
+    VkPhysicalDeviceProperties2 properties;
+    VkPhysicalDeviceIDProperties id;
+    VkPhysicalDevicePCIBusInfoPropertiesEXT pci;
+
+    if (!device_uuid || !domain || !bus || !device_id || !function)
+        return E_INVALIDARG;
+    memset(&properties, 0, sizeof(properties));
+    memset(&id, 0, sizeof(id));
+    memset(&pci, 0, sizeof(pci));
+    properties.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_PROPERTIES_2;
+    id.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_ID_PROPERTIES;
+    pci.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_PCI_BUS_INFO_PROPERTIES_EXT;
+    properties.pNext = &id;
+    id.pNext = &pci;
+    if (!device->vkd3d_instance->vk_procs.vkGetPhysicalDeviceProperties2)
+        return E_NOTIMPL;
+    device->vkd3d_instance->vk_procs.vkGetPhysicalDeviceProperties2(
+            device->vk_physical_device, &properties);
+    memcpy(device_uuid, id.deviceUUID, VK_UUID_SIZE);
+    *domain = pci.pciDomain;
+    *bus = pci.pciBus;
+    *device_id = pci.pciDevice;
+    *function = pci.pciFunction;
+    return S_OK;
+}
