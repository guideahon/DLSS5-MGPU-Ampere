+static VkPhysicalDevice d3d12_find_discrete_physical_device(struct vkd3d_instance *instance,
+        PFN_vkGetInstanceProcAddr pfn_vkGetInstanceProcAddr, unsigned int requested_index)
+{
+    PFN_vkEnumeratePhysicalDevices enumerate;
+    PFN_vkGetPhysicalDeviceProperties get_properties;
+    PFN_vkGetPhysicalDeviceProperties2 get_properties2;
+    VkPhysicalDevice devices[16];
+    VkInstance vk_instance = vkd3d_instance_get_vk_instance(instance);
+    uint32_t count = ARRAY_SIZE(devices);
+    unsigned int discrete_index = 0;
+
+    enumerate = (void *)pfn_vkGetInstanceProcAddr(vk_instance, "vkEnumeratePhysicalDevices");
+    get_properties = (void *)pfn_vkGetInstanceProcAddr(vk_instance, "vkGetPhysicalDeviceProperties");
+    get_properties2 = (void *)pfn_vkGetInstanceProcAddr(vk_instance, "vkGetPhysicalDeviceProperties2");
+    if (!enumerate || !get_properties || enumerate(vk_instance, &count, devices) < 0)
+        return VK_NULL_HANDLE;
+
+    for (uint32_t i = 0; i < count; ++i)
+    {
+        VkPhysicalDeviceProperties properties;
+        get_properties(devices[i], &properties);
+        if (properties.deviceType != VK_PHYSICAL_DEVICE_TYPE_DISCRETE_GPU)
+            continue;
+        if (get_properties2) {
+            VkPhysicalDeviceProperties2 properties2 = {VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_PROPERTIES_2};
+            VkPhysicalDeviceIDProperties id = {VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_ID_PROPERTIES};
+            VkPhysicalDevicePCIBusInfoPropertiesEXT pci = {VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_PCI_BUS_INFO_PROPERTIES_EXT};
+            properties2.pNext = &id;
+            id.pNext = &pci;
+            get_properties2(devices[i], &properties2);
+            fprintf(stderr, "VKD3D duplicate-LUID discrete[%u] uuid=%02x:%02x:%02x:%02x pci=%u:%u:%u.%u\n",
+                    discrete_index, id.deviceUUID[0], id.deviceUUID[1],
+                    id.deviceUUID[2], id.deviceUUID[3], pci.pciDomain,
+                    pci.pciBus, pci.pciDevice, pci.pciFunction);
+        }
+        if (discrete_index++ == requested_index)
+            return devices[i];
+    }
+    return VK_NULL_HANDLE;
+}
+
+/*
+ * Some Wine/DXGI stacks expose multiple physical adapters with one shared
+ * AdapterLuid.  That is normally harmless, but it prevents VKD3D's normal
+ * LUID-based matching from opening two Vulkan devices.  Keep this opt-in and
+ * use COM identity to recover the DXGI enumeration index for experiments.
+ */
+static bool d3d12_get_adapter_index(IDXGIAdapter *target, unsigned int *index)
+{
+    IDXGIFactory4 *factory = NULL;
+    IDXGIAdapter *current = NULL;
+    IUnknown *target_unknown = NULL;
+    HRESULT hr;
+    unsigned int i;
+
+    if (!target || !index)
+        return false;
+    if (FAILED(hr = IUnknown_QueryInterface(target, &IID_IUnknown,
+            (void **)&target_unknown)))
+        return false;
+    if (FAILED(hr = CreateDXGIFactory1(&IID_IDXGIFactory4, (void **)&factory)))
+        goto done;
+
+    for (i = 0; SUCCEEDED(IDXGIFactory4_EnumAdapters(factory, i, &current)); ++i)
+    {
+        IUnknown *current_unknown = NULL;
+        if (SUCCEEDED(IUnknown_QueryInterface(current, &IID_IUnknown,
+                (void **)&current_unknown)))
+        {
+            bool match = current_unknown == target_unknown;
+            IUnknown_Release(current_unknown);
+            IDXGIAdapter_Release(current);
+            current = NULL;
+            if (match)
+            {
+                *index = i;
+                hr = S_OK;
+                goto done;
+            }
+        }
+        else
+        {
+            IDXGIAdapter_Release(current);
+            current = NULL;
+        }
+    }
+
+    hr = E_FAIL;
+
+done:
+    if (current)
+        IDXGIAdapter_Release(current);
+    if (factory)
+        IDXGIFactory4_Release(factory);
+    if (target_unknown)
+        IUnknown_Release(target_unknown);
+    return SUCCEEDED(hr);
+}
