+bool ProbeLocalNgxAfterRemoteEnabled() {
+  char value[8]{};
+  const DWORD length = GetEnvironmentVariableA("MGPU_DLSSNR_PROBE_LOCAL_AFTER_REMOTE",
+                                               value, static_cast<DWORD>(sizeof(value)));
+  return length > 0 && _stricmp(value, "1") == 0;
+}
+
+void ProbeLocalNgxAfterRemote(FeatureState& state) {
+  if (!ProbeLocalNgxAfterRemoteEnabled() || state.local_after_remote_init_attempted ||
+      neural_ready || !state.remote_ngx_evaluate_succeeded || !device || !nr_init)
+    return;
+  state.local_after_remote_init_attempted = true;
+  char reset_value[8]{};
+  const DWORD reset_length = GetEnvironmentVariableA(
+      "MGPU_DLSSNR_RESET_REMOTE_BEFORE_LOCAL", reset_value,
+      static_cast<DWORD>(sizeof(reset_value)));
+  if (reset_length > 0 && _stricmp(reset_value, "1") == 0) {
+    if (state.remote_neural_handle != nullptr && remote_nr_release) {
+      const NVSDK_NGX_Result release_result = remote_nr_release(state.remote_neural_handle);
+      Log("resource_fd_pair_worker remote_before_local_release result=0x%08x",
+          release_result);
+      state.remote_neural_handle = nullptr;
+    }
+    if (remote_nr_shutdown && state.resource_fd_remote_device) {
+      const NVSDK_NGX_Result shutdown_result =
+          remote_nr_shutdown(state.resource_fd_remote_device.Get());
+      Log("resource_fd_pair_worker remote_before_local_shutdown result=0x%08x",
+          shutdown_result);
+    }
+  }
+  const NVSDK_NGX_Result result = nr_init(
+      snippet_application_id, snippet_data_path.c_str(), device.Get(), snippet_api_version,
+      snippet_feature_info);
+  Log("resource_fd_pair_worker local_after_remote_init result=0x%08x device=%p",
+      result, device.Get());
+  if (NVSDK_NGX_SUCCEED(result)) neural_ready = true;
+}
+
+void CreateLocalNgxAfterRemote(FeatureState& state,
+                              ID3D12GraphicsCommandList* commands,
+                              NVSDK_NGX_Parameter* parameters) {
+  if (!ProbeLocalNgxAfterRemoteEnabled() || state.local_after_remote_create_attempted ||
+      !neural_ready || state.neural_handle != nullptr || commands == nullptr ||
+      parameters == nullptr || !nr_create)
+    return;
+  state.local_after_remote_create_attempted = true;
+  int original_quality = 0;
+  parameters->Get("PerfQualityValue", &original_quality);
+  parameters->Set("CreationNodeMask", 1U);
+  parameters->Set("VisibilityNodeMask", 1U);
+  for (const char* name : {"Width", "OutWidth", "DLSSNR.Width", "DLSSNR.InputWidth",
+                           "DLSSNR.OutputWidth", "DLSSNR.Output.Width"})
+    parameters->Set(name, state.output_width);
+  for (const char* name : {"Height", "OutHeight", "DLSSNR.Height", "DLSSNR.InputHeight",
+                           "DLSSNR.OutputHeight", "DLSSNR.Output.Height"})
+    parameters->Set(name, state.output_height);
+  parameters->Set("DLSSNR.Hint.Render.Preset", 1U);
+  parameters->Set("PerfQualityValue", 6);
+  parameters->Set("DLSSNRComputeScalingRatioCallback",
+                  reinterpret_cast<void*>(&ScalingRatioCallback));
+  SetFloatParameter(parameters, "DLSSNR.ScalingRatio", 1.0F);
+  SetFloatParameter(parameters, "DLSSNR.Scale", 1.0F);
+  SetIntParameter(parameters, "DLSSNR.Upscaling", 0);
+  const NVSDK_NGX_Result result = nr_create(
+      commands, NVSDK_NGX_Feature_Reserved18, parameters, &state.neural_handle);
+  parameters->Set("Width", state.input_width);
+  parameters->Set("Height", state.input_height);
+  parameters->Set("OutWidth", state.output_width);
+  parameters->Set("OutHeight", state.output_height);
+  parameters->Set("PerfQualityValue", original_quality);
+  Log("resource_fd_pair_worker local_after_remote_create result=0x%08x handle=%p",
+      result, state.neural_handle);
+}
