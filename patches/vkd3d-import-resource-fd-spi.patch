diff --git a/include/vkd3d_device_vkd3d_ext.idl b/include/vkd3d_device_vkd3d_ext.idl
--- a/include/vkd3d_device_vkd3d_ext.idl
+++ b/include/vkd3d_device_vkd3d_ext.idl
@@ -224,0 +225,14 @@
+[
+    uuid(0f6c3c31-0d8b-4e9a-9a65-41ce6dd4d1c2),
+    object,
+    local,
+    pointer_default(unique)
+]
+interface ID3D12DeviceExt6 : ID3D12DeviceExt5
+{
+    /* Experimental Linux-only import of a Vulkan opaque-fd allocation into a
+     * D3D12 texture. Ownership of fd is consumed by the import attempt. */
+    HRESULT CreateResourceFromExternalFd(const D3D12_RESOURCE_DESC1 *desc, INT fd,
+            ID3D12Resource **resource);
+}
+
