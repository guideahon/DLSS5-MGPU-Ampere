diff --git a/libs/vkd3d/device_vkd3d_ext.c b/libs/vkd3d/device_vkd3d_ext.c
--- a/libs/vkd3d/device_vkd3d_ext.c
+++ b/libs/vkd3d/device_vkd3d_ext.c
@@ -415,0 +416,34 @@
+static HRESULT STDMETHODCALLTYPE d3d12_device_vkd3d_ext_CreateResourceFromExternalFd(
+        d3d12_device_vkd3d_ext_iface *iface, const D3D12_RESOURCE_DESC1 *desc,
+        INT fd, ID3D12Resource **ppResource)
+{
+    struct d3d12_device *device = d3d12_device_from_ID3D12DeviceExt(iface);
+    struct d3d12_resource *object;
+    D3D12_HEAP_PROPERTIES heap_properties = {
+        .Type = D3D12_HEAP_TYPE_DEFAULT,
+        .CPUPageProperty = D3D12_CPU_PAGE_PROPERTY_UNKNOWN,
+        .MemoryPoolPreference = D3D12_MEMORY_POOL_UNKNOWN,
+        .CreationNodeMask = 0,
+        .VisibleNodeMask = 0,
+    };
+    HRESULT hr;
+
+    if (!desc || fd < 0 || !ppResource)
+        return E_INVALIDARG;
+    *ppResource = NULL;
+
+    if (!getenv("VKD3D_IMPORT_RESOURCE_FD") || strcmp(getenv("VKD3D_IMPORT_RESOURCE_FD"), "1"))
+        return E_ACCESSDENIED;
+    if (desc->Dimension != D3D12_RESOURCE_DIMENSION_TEXTURE2D)
+        return E_NOTIMPL;
+
+    hr = d3d12_resource_create_committed(device, desc, &heap_properties,
+            D3D12_HEAP_FLAG_SHARED, D3D12_RESOURCE_STATE_COMMON, NULL,
+            0, NULL, (HANDLE)(INT_PTR)fd, &object);
+    if (FAILED(hr))
+        return hr;
+
+    *ppResource = (ID3D12Resource *)&object->ID3D12Resource_iface;
+    return S_OK;
+}
+
