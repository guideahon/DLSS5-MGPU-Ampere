diff --git a/src/core_proxy.cpp b/src/core_proxy.cpp
index fa3d39e..1c2c31b 100644
--- a/src/core_proxy.cpp
+++ b/src/core_proxy.cpp
@@ -676,0 +677,4 @@ void EvaluateRemoteNgx(FeatureState& state, NVSDK_NGX_Parameter* parameters) {
+  LARGE_INTEGER timer_frequency{};
