--- a/libs/vkd3d/device_vkd3d_ext.c
+++ b/libs/vkd3d/device_vkd3d_ext.c
@@ -1145,7 +1145,42 @@ static HRESULT STDMETHODCALLTYPE d3d12_dxvk_interop_device_GetVulkanHeapInfo(d3d
     return S_OK;
 }
 
-CONST_VTBL struct ID3D12DXVKInteropDevice3Vtbl d3d12_dxvk_interop_device_vtbl =
+static HRESULT STDMETHODCALLTYPE d3d12_dxvk_interop_device_ExportVulkanHeapFd(
+        d3d12_dxvk_interop_device_iface *iface, ID3D12Heap *heap, UINT32 handle_type, INT *fd)
+{
+    struct d3d12_device *device = d3d12_device_from_ID3D12DXVKInteropDevice(iface);
+    struct d3d12_heap *heap_impl;
+    VkMemoryGetFdInfoKHR fd_info;
+    VkResult vr;
+
+    if (!heap || !fd)
+        return E_INVALIDARG;
+    *fd = -1;
+    if (!device->vk_info.KHR_external_memory_fd || !device->vk_procs.vkGetMemoryFdKHR)
+        return E_NOTIMPL;
+    if (handle_type != VK_EXTERNAL_MEMORY_HANDLE_TYPE_OPAQUE_FD_BIT)
+        return E_INVALIDARG;
+
+    heap_impl = impl_from_ID3D12Heap(heap);
+    if (heap_impl->device != device ||
+            heap_impl->allocation.device_allocation.vk_memory == VK_NULL_HANDLE)
+        return E_INVALIDARG;
+    if (!getenv("VKD3D_EXPORT_HEAP_FD") || strcmp(getenv("VKD3D_EXPORT_HEAP_FD"), "1"))
+        return E_ACCESSDENIED;
+
+    memset(&fd_info, 0, sizeof(fd_info));
+    fd_info.sType = VK_STRUCTURE_TYPE_MEMORY_GET_FD_INFO_KHR;
+    fd_info.memory = heap_impl->allocation.device_allocation.vk_memory;
+    fd_info.handleType = VK_EXTERNAL_MEMORY_HANDLE_TYPE_OPAQUE_FD_BIT;
+    vr = device->vk_procs.vkGetMemoryFdKHR(device->vk_device, &fd_info, fd);
+    if (vr != VK_SUCCESS)
+        return hresult_from_vk_result(vr);
+
+    TRACE("heap %p exported fd %d.\n", heap, *fd);
+    return S_OK;
+}
+
+CONST_VTBL struct ID3D12DXVKInteropDevice4Vtbl d3d12_dxvk_interop_device_vtbl =
 {
     /* IUnknown methods */
     d3d12_dxvk_interop_device_QueryInterface,
@@ -1177,6 +1212,9 @@ CONST_VTBL struct ID3D12DXVKInteropDevice3Vtbl d3d12_dxvk_interop_device_vtbl =
 
     /* ID3D12DXVKInteropDevice3 methods */
     d3d12_dxvk_interop_device_GetVulkanHeapInfo,
+
+    /* ID3D12DXVKInteropDevice4 methods */
+    d3d12_dxvk_interop_device_ExportVulkanHeapFd,
 };
 
