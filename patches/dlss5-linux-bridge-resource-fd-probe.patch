+void ProbeResourceFd(const char* name, ID3D12Resource* resource) {
+  if (!TransportResourceFdProbeEnabled() || resource == nullptr || !device) return;
+  const char* helper_path = std::getenv("MGPU_CUDA_IMPORT_HELPER");
+  HMODULE ntdll = GetModuleHandleA("ntdll.dll");
+  auto spawn = ntdll == nullptr ? nullptr : reinterpret_cast<WineUnixSpawnvp>(
+      GetProcAddress(ntdll, "__wine_unix_spawnvp"));
+  if (helper_path == nullptr || *helper_path == '\0' || spawn == nullptr) {
+    Log("resource_fd_probe unavailable name=%s helper=%s spawn=%p", name,
+        helper_path ? helper_path : "", spawn);
+    return;
+  }
+
+  Vkd3dInterop6* interop = nullptr;
+  const HRESULT query = device->QueryInterface(
+      kVkd3dInteropDevice6, reinterpret_cast<void**>(&interop));
+  if (FAILED(query) || interop == nullptr) {
+    Log("resource_fd_probe query_interop6 name=%s hr=0x%08x", name, query);
+    return;
+  }
+
+  SetEnvironmentVariableA("VKD3D_EXPORT_RESOURCE_FD", "1");
+  int fd = -1;
+  UINT64 offset = 0;
+  UINT64 size = 0;
+  const HRESULT export_result = interop->lpVtbl->ExportVulkanResourceFd(
+      reinterpret_cast<Vkd3dInteropDevice*>(interop), resource, 1U, &fd,
+      &offset, &size);
+  Log("resource_fd_probe export name=%s hr=0x%08x fd=%d offset=%llu size=%llu",
+      name, export_result, fd, static_cast<unsigned long long>(offset),
+      static_cast<unsigned long long>(size));
+  if (SUCCEEDED(export_result) && fd >= 0 && size > offset) {
+    char fd_text[32];
+    char size_text[32];
+    char source_text[16];
+    char destination_text[16];
+    char offset_text[32];
+    char* end = nullptr;
+    const char* source_value = std::getenv("MGPU_CUDA_SOURCE_ORDINAL");
+    const char* destination_value = std::getenv("MGPU_CUDA_DESTINATION_ORDINAL");
+    const int source = source_value ? static_cast<int>(std::strtol(source_value, &end, 10)) : 0;
+    end = nullptr;
+    const int destination = destination_value
+        ? static_cast<int>(std::strtol(destination_value, &end, 10)) : 1;
+    std::snprintf(fd_text, sizeof(fd_text), "%d", fd);
+    std::snprintf(size_text, sizeof(size_text), "%llu",
+                  static_cast<unsigned long long>(size));
+    std::snprintf(source_text, sizeof(source_text), "%d", source);
+    std::snprintf(destination_text, sizeof(destination_text), "%d", destination);
+    std::snprintf(offset_text, sizeof(offset_text), "%llu",
+                  static_cast<unsigned long long>(offset));
+    char* argv[] = {const_cast<char*>(helper_path), fd_text, size_text,
+                    source_text, destination_text, offset_text,
+                    const_cast<char*>("readonly"), nullptr};
+    SetEnvironmentVariableA("MGPU_INHERIT_FD", fd_text);
+    SetEnvironmentVariableA("MGPU_CUDA_IMPORT_READONLY", "1");
+    const LONG spawn_result = spawn(argv, 1);
+    SetEnvironmentVariableA("MGPU_CUDA_IMPORT_READONLY", nullptr);
+    SetEnvironmentVariableA("MGPU_INHERIT_FD", nullptr);
+    Log("resource_fd_probe helper name=%s path=%s spawn_rc=%ld source=%d destination=%d readonly=1",
+        name, helper_path, static_cast<long>(spawn_result), source, destination);
+  }
+  interop->lpVtbl->Release(reinterpret_cast<Vkd3dInteropDevice*>(interop));
+  SetEnvironmentVariableA("VKD3D_EXPORT_RESOURCE_FD", nullptr);
+}
