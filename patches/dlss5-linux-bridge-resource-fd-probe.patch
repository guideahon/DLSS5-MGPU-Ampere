+void ProbeResourceFd(const char* name, ID3D12Resource* resource) {
+  if (!TransportResourceFdProbeEnabled() || resource == nullptr || !device) return;
+  const char* helper_path = std::getenv("MGPU_VULKAN_IMAGE_IMPORT_HELPER");
+  HMODULE ntdll = GetModuleHandleA("ntdll.dll");
+  auto spawn = ntdll == nullptr ? nullptr : reinterpret_cast<WineUnixSpawnvp>(
+      GetProcAddress(ntdll, "__wine_unix_spawnvp"));
+  if (!helper_path || !*helper_path || !spawn) {
+    Log("resource_fd_probe unavailable name=%s helper=%s spawn=%p", name,
+        helper_path ? helper_path : "", spawn);
+    return;
+  }
+  Vkd3dInterop6* interop = nullptr;
+  const HRESULT query = device->QueryInterface(kVkd3dInteropDevice6,
+      reinterpret_cast<void**>(&interop));
+  if (FAILED(query) || !interop) {
+    Log("resource_fd_probe query_interop6 name=%s hr=0x%08x", name, query);
+    return;
+  }
+  const D3D12_RESOURCE_DESC description = resource->GetDesc();
+  SetEnvironmentVariableA("VKD3D_EXPORT_RESOURCE_FD", "1");
+  int fd = -1; UINT64 offset = 0, size = 0;
+  const HRESULT export_result = interop->lpVtbl->ExportVulkanResourceFd(
+      reinterpret_cast<Vkd3dInteropDevice*>(interop), resource, 1U, &fd,
+      &offset, &size);
+  Log("resource_fd_probe export name=%s hr=0x%08x fd=%d offset=%llu size=%llu format=%u",
+      name, export_result, fd, static_cast<unsigned long long>(offset),
+      static_cast<unsigned long long>(size), static_cast<unsigned int>(description.Format));
+  if (SUCCEEDED(export_result) && fd >= 0 && size > 0 &&
+      description.Dimension == D3D12_RESOURCE_DIMENSION_TEXTURE2D) {
+    char fd_text[32], size_text[32], destination_text[16], width_text[16];
+    char height_text[16], format_text[16], offset_text[32];
+    char* end = nullptr;
+    const char* value = std::getenv("MGPU_CUDA_DESTINATION_ORDINAL");
+    const int destination = value ? static_cast<int>(std::strtol(value, &end, 10)) : 1;
+    std::snprintf(fd_text, sizeof(fd_text), "%d", fd);
+    std::snprintf(size_text, sizeof(size_text), "%llu", static_cast<unsigned long long>(size));
+    std::snprintf(destination_text, sizeof(destination_text), "%d", destination);
+    std::snprintf(width_text, sizeof(width_text), "%u", description.Width > UINT32_MAX ? UINT32_MAX : static_cast<UINT32>(description.Width));
+    std::snprintf(height_text, sizeof(height_text), "%u", description.Height);
+    std::snprintf(format_text, sizeof(format_text), "%u", static_cast<unsigned int>(description.Format));
+    std::snprintf(offset_text, sizeof(offset_text), "%llu", static_cast<unsigned long long>(offset));
+    char* argv[] = {const_cast<char*>(helper_path), fd_text, size_text, destination_text,
+                    width_text, height_text, format_text, offset_text,
+                    const_cast<char*>("bind-only"), nullptr};
+    SetEnvironmentVariableA("MGPU_INHERIT_FD", fd_text);
+    SetEnvironmentVariableA("MGPU_VULKAN_IMAGE_IMPORT_MODE", "bind-only");
+    const LONG spawn_result = spawn(argv, 1);
+    SetEnvironmentVariableA("MGPU_INHERIT_FD", nullptr);
+    SetEnvironmentVariableA("MGPU_VULKAN_IMAGE_IMPORT_MODE", nullptr);
+    Log("resource_fd_probe helper name=%s path=%s spawn_rc=%ld destination=%d",
+        name, helper_path, static_cast<long>(spawn_result), destination);
+  }
+  interop->lpVtbl->Release(reinterpret_cast<Vkd3dInteropDevice*>(interop));
+  SetEnvironmentVariableA("VKD3D_EXPORT_RESOURCE_FD", nullptr);
+}
