+// Loader audit: this is intentionally opt-in and has no effect on the
+// NGX call path. It makes a real game's DLL load observable even when the
+// engine never reaches an exported NGX entry point.
+extern "C" BOOL WINAPI DllMain(HINSTANCE instance, DWORD reason, LPVOID reserved) {
+  (void)reserved;
+  if (reason == DLL_PROCESS_ATTACH) {
+    DisableThreadLibraryCalls(instance);
+    OutputDebugStringA("dlss5-mgpu bridge-nvngx.dll process attach\n");
+    Log("loader_audit dll_process_attach");
+  }
+  return TRUE;
+}
