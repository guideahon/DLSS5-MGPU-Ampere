-CONST_VTBL struct ID3D12DXVKInteropDevice5Vtbl d3d12_dxvk_interop_device_vtbl =
+static HRESULT STDMETHODCALLTYPE d3d12_dxvk_interop_device_ExportVulkanResourceFd(
+        d3d12_dxvk_interop_device_iface *iface, ID3D12Resource *resource_iface,
+        UINT32 handle_type, INT *fd, UINT64 *resource_offset, UINT64 *allocation_size)
+{
+    struct d3d12_device *device = d3d12_device_from_ID3D12DXVKInteropDevice(iface);
+    struct d3d12_resource *resource;
+    struct vkd3d_memory_allocation *allocation;
+    VkMemoryGetFdInfoKHR fd_info;
+    VkResult vr;
+
+    if (!resource_iface || !fd || !resource_offset || !allocation_size)
+        return E_INVALIDARG;
+    *fd = -1;
+    *resource_offset = 0;
+    *allocation_size = 0;
+    if (!getenv("VKD3D_EXPORT_RESOURCE_FD") || strcmp(getenv("VKD3D_EXPORT_RESOURCE_FD"), "1"))
+        return E_ACCESSDENIED;
+    if (!device->vk_info.KHR_external_memory_fd || !device->vk_procs.vkGetMemoryFdKHR)
+        return E_NOTIMPL;
+    if (handle_type != VK_EXTERNAL_MEMORY_HANDLE_TYPE_OPAQUE_FD_BIT)
+        return E_INVALIDARG;
+
+    resource = impl_from_ID3D12Resource(resource_iface);
+    if (resource->device != device)
+        return E_INVALIDARG;
+    allocation = (resource->flags & VKD3D_RESOURCE_LINEAR_STAGING_COPY)
+            ? &resource->private_mem : &resource->mem;
+    if (allocation->device_allocation.vk_memory == VK_NULL_HANDLE)
+        return E_INVALIDARG;
+
+    memset(&fd_info, 0, sizeof(fd_info));
+    fd_info.sType = VK_STRUCTURE_TYPE_MEMORY_GET_FD_INFO_KHR;
+    fd_info.memory = allocation->device_allocation.vk_memory;
+    fd_info.handleType = VK_EXTERNAL_MEMORY_HANDLE_TYPE_OPAQUE_FD_BIT;
+    vr = device->vk_procs.vkGetMemoryFdKHR(device->vk_device, &fd_info, fd);
+    if (vr != VK_SUCCESS)
+        return hresult_from_vk_result(vr);
+
+    *resource_offset = allocation->offset;
+    *allocation_size = allocation->device_allocation.size;
+    TRACE("resource %p exported fd %d offset %"PRIu64" size %"PRIu64".\n",
+            resource_iface, *fd, *resource_offset, *allocation_size);
+    return S_OK;
+}
+
+CONST_VTBL struct ID3D12DXVKInteropDevice6Vtbl d3d12_dxvk_interop_device_vtbl =
 {
@@ -1289,3 +1334,6 @@
     d3d12_dxvk_interop_device_ExportVulkanFenceFd,
     d3d12_dxvk_interop_device_GetVulkanPhysicalDeviceIdentity,
+
