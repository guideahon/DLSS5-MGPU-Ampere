+    d3d12_dxvk_interop_device_ExportVulkanResourceFd,
 };
diff --git a/libs/vkd3d/memory.c b/libs/vkd3d/memory.c
--- a/libs/vkd3d/memory.c
+++ b/libs/vkd3d/memory.c
@@ -2216,8 +2216,24 @@
 {
     struct vkd3d_allocate_memory_info tmp_info;
+    struct vkd3d_allocate_memory_info exported_info;
+    VkExportMemoryAllocateInfo export_info;
     bool implementation_can_zero_clear_alloc;
     bool needs_command_clear;
     bool suballocate;
     HRESULT hr;
 
+    /* Direct resource exports need the allocation itself to carry the FD
+     * export bit. Heap export alone does not cover committed game images. */
+    if (getenv("VKD3D_EXPORT_RESOURCE_FD") &&
+            !strcmp(getenv("VKD3D_EXPORT_RESOURCE_FD"), "1"))
+    {
+        memset(&export_info, 0, sizeof(export_info));
+        export_info.sType = VK_STRUCTURE_TYPE_EXPORT_MEMORY_ALLOCATE_INFO;
+        export_info.handleTypes = VK_EXTERNAL_MEMORY_HANDLE_TYPE_OPAQUE_FD_BIT;
+        export_info.pNext = info->pNext;
+        exported_info = *info;
+        exported_info.pNext = &export_info;
+        info = &exported_info;
+    }
+
     suballocate = vkd3d_memory_info_allow_suballocate(device, info);
