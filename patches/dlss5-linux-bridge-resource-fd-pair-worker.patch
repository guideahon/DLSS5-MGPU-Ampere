+void ProbeRemoteNgxQueue(FeatureState& state) {
+  if (!RemoteNgxQueueProbeEnabled() || !state.resource_fd_remote_device) return;
+  D3D12_COMMAND_QUEUE_DESC queue_desc{};
+  queue_desc.Type = D3D12_COMMAND_LIST_TYPE_DIRECT;
+  ComPtr<ID3D12CommandQueue> queue;
+  ComPtr<ID3D12CommandAllocator> allocator;
+  ComPtr<ID3D12GraphicsCommandList> commands;
+  ComPtr<ID3D12Fence> fence;
+  HRESULT result = state.resource_fd_remote_device->CreateCommandQueue(
+      &queue_desc, IID_PPV_ARGS(&queue));
+  if (SUCCEEDED(result)) result = state.resource_fd_remote_device->CreateCommandAllocator(
+      D3D12_COMMAND_LIST_TYPE_DIRECT, IID_PPV_ARGS(&allocator));
+  if (SUCCEEDED(result)) result = state.resource_fd_remote_device->CreateCommandList(
+      0, D3D12_COMMAND_LIST_TYPE_DIRECT, allocator.Get(), nullptr,
+      IID_PPV_ARGS(&commands));
+  if (SUCCEEDED(result)) result = state.resource_fd_remote_device->CreateFence(
+      0, D3D12_FENCE_FLAG_NONE, IID_PPV_ARGS(&fence));
+  HANDLE event_handle = SUCCEEDED(result) ? CreateEventW(nullptr, FALSE, FALSE, nullptr) : nullptr;
+  if (event_handle == nullptr) result = E_FAIL;
+  if (SUCCEEDED(result)) result = commands->Close();
+  if (SUCCEEDED(result)) {
+    ID3D12CommandList* lists[] = {commands.Get()};
+    queue->ExecuteCommandLists(1, lists);
+    result = queue->Signal(fence.Get(), 1);
+  }
+  DWORD wait_result = WAIT_OBJECT_0;
+  if (SUCCEEDED(result) && fence->GetCompletedValue() < 1) {
+    result = fence->SetEventOnCompletion(1, event_handle);
+    if (SUCCEEDED(result)) {
+      wait_result = WaitForSingleObject(event_handle, 5000);
+      if (wait_result != WAIT_OBJECT_0) result = HRESULT_FROM_WIN32(ERROR_TIMEOUT);
+    }
+  }
+  Log("resource_fd_pair_worker empty_queue_probe result=0x%08x completed=%llu wait=%lu",
+      result, static_cast<unsigned long long>(fence ? fence->GetCompletedValue() : 0),
+      static_cast<unsigned long>(wait_result));
+  if (event_handle != nullptr) CloseHandle(event_handle);
+}
