+
+void EvaluateRemoteNgx(FeatureState& state, NVSDK_NGX_Parameter* parameters) {
+  if (!RemoteNgxFeatureProbeEnabled() || !state.remote_ngx_feature_ready ||
+      state.remote_neural_handle == nullptr || parameters == nullptr ||
+      !ResolveRemoteNgxRuntime()) return;
+  struct Slot { const char* name; ID3D12Resource* replacement; ID3D12Resource* saved; };
+  Slot slots[] = {
+      {"DLSSNR.Color", state.resource_fd_remote_output.Get(), nullptr},
+      {"DLSSNR.Output", state.resource_fd_remote_neural_output.Get(), nullptr},
+      {"DLSSNR.MVec", state.resource_fd_remote_motion.Get(), nullptr},
+      {"DLSSNR.Depth", state.resource_fd_remote_depth.Get(), nullptr}};
+  for (auto& slot : slots) GetResourceParameter(parameters, slot.name, &slot.saved);
+  for (auto& slot : slots) SetResource(parameters, slot.name, slot.replacement);
+  SetIntParameter(parameters, "DLSSNR.Enabled", 1);
+  SetFloatParameter(parameters, "DLSSNR.ScalingRatio", 1.0F);
+  SetFloatParameter(parameters, "DLSSNR.Scale", 1.0F);
+  SetIntParameter(parameters, "DLSSNR.Upscaling", 0);
+  parameters->Set("DLSSNR.ColorSubrectWidth", state.input_width);
+  parameters->Set("DLSSNR.ColorSubrectHeight", state.input_height);
+  parameters->Set("DLSSNR.OutputSubrectWidth", state.output_width);
+  parameters->Set("DLSSNR.OutputSubrectHeight", state.output_height);
+  parameters->Set("DLSSNR.MVecSubrectWidth", state.input_width);
+  parameters->Set("DLSSNR.MVecSubrectHeight", state.input_height);
+  parameters->Set("DLSSNR.DepthSubrectWidth", state.input_width);
+  parameters->Set("DLSSNR.DepthSubrectHeight", state.input_height);
+  SetFloatParameter(parameters, "DLSSNR.MVecScaleX", 1.0F);
+  SetFloatParameter(parameters, "DLSSNR.MVecScaleY", 1.0F);
+  SetIntParameter(parameters, "DLSSNR.DepthInverted", 0);
+  SetIntParameter(parameters, "DLSSNR.Reset", 0);
+  SetFloatParameter(parameters, "DLSSNR.Intensity", 1.0F);
+  SetFloatParameter(parameters, "DLSSNR.LocalToneStrength", 1.0F);
+  SetFloatParameter(parameters, "DLSSNR.LocalStructureStrength", 1.0F);
+  SetFloatParameter(parameters, "DLSSNR.GlobalToneStrength", 1.0F);
+  SetIntParameter(parameters, "DLSSNR.UseAutoMask", 0);
+  SetFloatParameter(parameters, "DLSSNR.SkinStructureStrength", 1.0F);
+  SetIntParameter(parameters, "DLSSNR.Style", 0);
+  SetIntParameter(parameters, "DLSSNR.UICorrection", 0);
+  Transition(state.remote_ngx_commands.Get(), state.resource_fd_remote_output.Get(),
+             D3D12_RESOURCE_STATE_COMMON,
+             D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE);
+  Transition(state.remote_ngx_commands.Get(), state.resource_fd_remote_motion.Get(),
+             D3D12_RESOURCE_STATE_COMMON,
+             D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE);
+  Transition(state.remote_ngx_commands.Get(), state.resource_fd_remote_depth.Get(),
+             D3D12_RESOURCE_STATE_COMMON,
+             D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE);
+  Transition(state.remote_ngx_commands.Get(), state.resource_fd_remote_neural_output.Get(),
+             D3D12_RESOURCE_STATE_COMMON,
+             D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+  const NVSDK_NGX_Result evaluate_result = remote_nr_evaluate(
+      state.remote_ngx_commands.Get(), state.remote_neural_handle, parameters, nullptr);
+  for (auto& slot : slots) SetResource(parameters, slot.name, slot.saved);
+  Log("resource_fd_pair_worker remote_ngx_evaluate result=0x%08x",
+      evaluate_result);
+  if (NVSDK_NGX_FAILED(evaluate_result)) {
+    state.remote_ngx_feature_ready = false;
+    return;
+  }
+
+  HRESULT result = state.remote_ngx_commands->Close();
+  if (SUCCEEDED(result)) {
+    ID3D12CommandList* lists[] = {state.remote_ngx_commands.Get()};
+    state.remote_ngx_queue->ExecuteCommandLists(1, lists);
+    ++state.remote_ngx_fence_value;
+    result = state.remote_ngx_queue->Signal(state.remote_ngx_fence.Get(),
+                                            state.remote_ngx_fence_value);
+  }
+  DWORD wait_result = WAIT_OBJECT_0;
+  if (SUCCEEDED(result) && state.remote_ngx_fence->GetCompletedValue() <
+      state.remote_ngx_fence_value) {
+    result = state.remote_ngx_fence->SetEventOnCompletion(
+        state.remote_ngx_fence_value, state.remote_ngx_fence_event);
+    if (SUCCEEDED(result)) {
+      wait_result = WaitForSingleObject(state.remote_ngx_fence_event, 5000);
+      if (wait_result != WAIT_OBJECT_0) result = HRESULT_FROM_WIN32(ERROR_TIMEOUT);
+    }
+  }
+  Log("resource_fd_pair_worker remote_ngx_submit result=0x%08x device_removed=0x%08x fence=%llu completed=%llu wait=%lu",
+      result, state.resource_fd_remote_device->GetDeviceRemovedReason(),
+      static_cast<unsigned long long>(state.remote_ngx_fence_value),
+      static_cast<unsigned long long>(state.remote_ngx_fence->GetCompletedValue()),
+      static_cast<unsigned long>(wait_result));
+  state.remote_ngx_evaluate_succeeded =
+      NVSDK_NGX_SUCCEED(evaluate_result) && SUCCEEDED(result) &&
