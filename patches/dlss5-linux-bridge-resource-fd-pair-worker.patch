+bool ResolveRemoteNgxRuntime() {
+  if (remote_nr_init && remote_nr_create && remote_nr_evaluate && remote_nr_release)
+    return true;
+  wchar_t path[4096]{};
+  const DWORD length = GetEnvironmentVariableW(L"MGPU_DLSSNR_REMOTE_RUNTIME_DLL",
+                                                path, static_cast<DWORD>(std::size(path)));
+  if (length > 0 && length < std::size(path)) {
+    remote_nr_module = LoadLibraryW(path);
+    if (remote_nr_module == nullptr) {
+      Log("resource_fd_pair_worker remote_runtime_load_failed win32=%lu", GetLastError());
+      return false;
+    }
+    remote_nr_init = Resolve<Init>(remote_nr_module, "NVSDK_NGX_D3D12_Init_Ext");
+    remote_nr_create = Resolve<Create>(remote_nr_module, "NVSDK_NGX_D3D12_CreateFeature");
+    remote_nr_evaluate = Resolve<Evaluate>(remote_nr_module, "NVSDK_NGX_D3D12_EvaluateFeature");
+    remote_nr_release = Resolve<Release>(remote_nr_module, "NVSDK_NGX_D3D12_ReleaseFeature");
+    remote_nr_shutdown = Resolve<Shutdown>(remote_nr_module, "NVSDK_NGX_D3D12_Shutdown1");
+    Log("resource_fd_pair_worker remote_runtime_loaded path=%ls isolated=%d",
+        path, remote_nr_init && remote_nr_create && remote_nr_evaluate && remote_nr_release);
+  } else {
+    remote_nr_init = nr_init;
+    remote_nr_create = nr_create;
+    remote_nr_evaluate = nr_evaluate;
+    remote_nr_release = nr_release;
+    remote_nr_shutdown = nr_shutdown;
+    Log("resource_fd_pair_worker remote_runtime_loaded isolated=0");
+  }
+  return remote_nr_init && remote_nr_create && remote_nr_evaluate && remote_nr_release;
+}
 
