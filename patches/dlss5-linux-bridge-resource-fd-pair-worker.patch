+    result = state.resource_fd_remote_device->CreateCommandList(
+        0, D3D12_COMMAND_LIST_TYPE_DIRECT, state.remote_ngx_allocator.Get(), nullptr,
+        IID_PPV_ARGS(&state.remote_ngx_commands));
+  }
+  if (SUCCEEDED(result)) {
+    result = state.resource_fd_remote_device->CreateFence(
+        0, D3D12_FENCE_FLAG_NONE, IID_PPV_ARGS(&state.remote_ngx_fence));
+    state.remote_ngx_fence_event = CreateEventW(nullptr, FALSE, FALSE, nullptr);
+    if (state.remote_ngx_fence_event == nullptr) result = E_FAIL;
+  }
+  if (FAILED(result)) {
+    Log("resource_fd_pair_worker remote_ngx_command_setup hr=0x%08x", result);
+    return;
+  }
+
+  struct Slot { const char* name; ID3D12Resource* replacement; ID3D12Resource* saved; };
+  Slot slots[] = {
+      {"DLSSNR.Color", state.resource_fd_remote_output.Get(), nullptr},
+      {"DLSSNR.Output", state.resource_fd_remote_neural_output.Get(), nullptr},
+      {"DLSSNR.MVec", state.resource_fd_remote_motion.Get(), nullptr},
+      {"DLSSNR.Depth", state.resource_fd_remote_depth.Get(), nullptr}};
+  for (auto& slot : slots) GetResourceParameter(parameters, slot.name, &slot.saved);
