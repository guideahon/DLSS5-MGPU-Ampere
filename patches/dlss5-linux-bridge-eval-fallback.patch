+/* Keep the direct signed-DLSS call compatible with the public D3D12 helper
+ * contract.  Games normally populate these values through the SDK helper,
+ * but a proxy must also work when a host writes only the compact resource
+ * slots.  Missing optional values are otherwise reported by the runtime as
+ * FAIL_InvalidParameter (0xbad00005). */
+void NormalizeDlssEvaluationParameters(NVSDK_NGX_Parameter* parameters,
+                                       unsigned int input_width,
+                                       unsigned int input_height,
+                                       unsigned int output_width,
+                                       unsigned int output_height,
+                                       float sharpness, float motion_scale_x,
+                                       float motion_scale_y, int reset) {
+  if (parameters == nullptr) return;
+  parameters->Set(NVSDK_NGX_Parameter_Width, input_width);
+  parameters->Set(NVSDK_NGX_Parameter_Height, input_height);
+  parameters->Set(NVSDK_NGX_Parameter_OutWidth, output_width);
+  parameters->Set(NVSDK_NGX_Parameter_OutHeight, output_height);
+  SetFloatParameter(parameters, NVSDK_NGX_Parameter_Sharpness, sharpness);
+  SetFloatParameter(parameters, NVSDK_NGX_Parameter_Jitter_Offset_X, 0.0F);
+  SetFloatParameter(parameters, NVSDK_NGX_Parameter_Jitter_Offset_Y, 0.0F);
+  SetFloatParameter(parameters, NVSDK_NGX_Parameter_MV_Scale_X,
+                    motion_scale_x == 0.0F ? 1.0F : motion_scale_x);
+  SetFloatParameter(parameters, NVSDK_NGX_Parameter_MV_Scale_Y,
+                    motion_scale_y == 0.0F ? 1.0F : motion_scale_y);
+  SetIntParameter(parameters, NVSDK_NGX_Parameter_Reset, reset);
+  parameters->Set(NVSDK_NGX_Parameter_DLSS_Input_Color_Subrect_Base_X, 0U);
+  parameters->Set(NVSDK_NGX_Parameter_DLSS_Input_Color_Subrect_Base_Y, 0U);
+  parameters->Set(NVSDK_NGX_Parameter_DLSS_Input_Depth_Subrect_Base_X, 0U);
+  parameters->Set(NVSDK_NGX_Parameter_DLSS_Input_Depth_Subrect_Base_Y, 0U);
+  parameters->Set(NVSDK_NGX_Parameter_DLSS_Input_MV_SubrectBase_X, 0U);
+  parameters->Set(NVSDK_NGX_Parameter_DLSS_Input_MV_SubrectBase_Y, 0U);
+  parameters->Set(NVSDK_NGX_Parameter_DLSS_Output_Subrect_Base_X, 0U);
+  parameters->Set(NVSDK_NGX_Parameter_DLSS_Output_Subrect_Base_Y, 0U);
+  parameters->Set(NVSDK_NGX_Parameter_DLSS_Render_Subrect_Dimensions_Width,
+                  input_width);
+  parameters->Set(NVSDK_NGX_Parameter_DLSS_Render_Subrect_Dimensions_Height,
+                  input_height);
+  SetFloatParameter(parameters, NVSDK_NGX_Parameter_DLSS_Pre_Exposure, 1.0F);
+  SetFloatParameter(parameters, NVSDK_NGX_Parameter_DLSS_Exposure_Scale, 1.0F);
+  SetIntParameter(parameters, NVSDK_NGX_Parameter_DLSS_Indicator_Invert_X_Axis, 0);
+  SetIntParameter(parameters, NVSDK_NGX_Parameter_DLSS_Indicator_Invert_Y_Axis, 0);
+}
