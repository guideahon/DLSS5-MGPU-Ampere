+static HRESULT STDMETHODCALLTYPE d3d12_dxvk_interop_device_ExportVulkanFenceFd(
+        d3d12_dxvk_interop_device_iface *iface, ID3D12Fence *fence_iface,
+        UINT32 handle_type, INT *fd)
+{
+    struct d3d12_device *device = d3d12_device_from_ID3D12DXVKInteropDevice(iface);
+    struct d3d12_shared_fence *fence;
+    VkSemaphoreGetFdInfoKHR fd_info;
+    VkResult vr;
+
+    if (!fence_iface || !fd)
+        return E_INVALIDARG;
+    *fd = -1;
+    fprintf(stderr, "VKD3D fence fd export handle=0x%x ext=%u proc=%p env=%s\\n",
+            handle_type, device->vk_info.KHR_external_semaphore_fd ? 1 : 0,
+            (void *)device->vk_procs.vkGetSemaphoreFdKHR,
+            getenv("VKD3D_EXPORT_FENCE_FD") ? getenv("VKD3D_EXPORT_FENCE_FD") : "<unset>");
+    if (handle_type != VK_EXTERNAL_SEMAPHORE_HANDLE_TYPE_OPAQUE_FD_BIT ||
+            !device->vk_info.KHR_external_semaphore_fd ||
+            !device->vk_procs.vkGetSemaphoreFdKHR)
+        return E_NOTIMPL;
+    if (!getenv("VKD3D_EXPORT_FENCE_FD") || strcmp(getenv("VKD3D_EXPORT_FENCE_FD"), "1"))
+        return E_ACCESSDENIED;
+    if (!is_shared_ID3D12Fence(fence_iface))
+        return E_INVALIDARG;
+
+    fence = shared_impl_from_ID3D12Fence(fence_iface);
+    if (fence->device != device || fence->timeline_semaphore == VK_NULL_HANDLE)
+        return E_INVALIDARG;
+    memset(&fd_info, 0, sizeof(fd_info));
+    fd_info.sType = VK_STRUCTURE_TYPE_SEMAPHORE_GET_FD_INFO_KHR;
+    fd_info.semaphore = fence->timeline_semaphore;
+    fd_info.handleType = VK_EXTERNAL_SEMAPHORE_HANDLE_TYPE_OPAQUE_FD_BIT;
+    vr = device->vk_procs.vkGetSemaphoreFdKHR(device->vk_device, &fd_info, fd);
+    return vr == VK_SUCCESS ? S_OK : hresult_from_vk_result(vr);
+}
+
+static HRESULT STDMETHODCALLTYPE d3d12_dxvk_interop_device_GetVulkanPhysicalDeviceIdentity(
+        d3d12_dxvk_interop_device_iface *iface, UINT8 *device_uuid, UINT32 *domain,
+        UINT32 *bus, UINT32 *device_id, UINT32 *function)
+{
+    struct d3d12_device *device = d3d12_device_from_ID3D12DXVKInteropDevice(iface);
+    VkPhysicalDeviceProperties2 properties;
+    VkPhysicalDeviceIDProperties id;
+    VkPhysicalDevicePCIBusInfoPropertiesEXT pci;
+
+    if (!device_uuid || !domain || !bus || !device_id || !function)
+        return E_INVALIDARG;
+    memset(&properties, 0, sizeof(properties));
+    memset(&id, 0, sizeof(id));
+    memset(&pci, 0, sizeof(pci));
+    properties.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_PROPERTIES_2;
+    id.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_ID_PROPERTIES;
+    pci.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_PCI_BUS_INFO_PROPERTIES_EXT;
+    properties.pNext = &id;
+    id.pNext = &pci;
+    if (!device->vkd3d_instance->vk_procs.vkGetPhysicalDeviceProperties2)
+        return E_NOTIMPL;
+    device->vkd3d_instance->vk_procs.vkGetPhysicalDeviceProperties2(
+            device->vk_physical_device, &properties);
+    memcpy(device_uuid, id.deviceUUID, VK_UUID_SIZE);
+    *domain = pci.pciDomain;
+    *bus = pci.pciBus;
+    *device_id = pci.pciDevice;
+    *function = pci.pciFunction;
+    return S_OK;
+}
