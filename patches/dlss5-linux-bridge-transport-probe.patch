+bool TransportProbeEnabled() {
+  char value[32]{};
+  const DWORD length = GetEnvironmentVariableA("MGPU_DLSSNR_TRANSPORT", value,
+                                               static_cast<DWORD>(sizeof(value)));
+  return length > 0 && _stricmp(value, "probe") == 0;
+}
+
+void ProbeTransportResources(ID3D12Resource* color, ID3D12Resource* output,
+                             ID3D12Resource* motion, ID3D12Resource* depth) {
+  if (!TransportProbeEnabled() || !device) return;
+  Vkd3dInteropDevice* interop = nullptr;
+  const HRESULT query = device->QueryInterface(kVkd3dInteropDevice,
+                                                 reinterpret_cast<void**>(&interop));
+  if (FAILED(query) || interop == nullptr) {
+    Log("transport_probe query_interop hr=0x%08x", query);
+    return;
+  }
+  VkInstance instance = nullptr;
+  VkPhysicalDevice physical = nullptr;
+  VkDevice vk_device = nullptr;
+  const HRESULT handles = interop->lpVtbl->GetVulkanHandles(
+      interop, &instance, &physical, &vk_device);
+  Log("transport_probe handles hr=0x%08x instance=%p physical=%p device=%p",
+      handles, instance, physical, vk_device);
+  struct ResourceEntry { const char* name; ID3D12Resource* resource; };
+  const std::array<ResourceEntry, 4> entries = {{{"color", color}, {"output", output},
+                                                  {"motion", motion}, {"depth", depth}}};
+  for (const auto& entry : entries) {
+    if (entry.resource == nullptr) continue;
+    UINT64 handle = 0;
+    UINT64 offset = 0;
+    int layout = 0;
+    HRESULT result = E_NOTIMPL;
+    if (interop->lpVtbl->GetVulkanResourceInfo1 != nullptr) {
+      result = interop->lpVtbl->GetVulkanResourceInfo1(
+          interop, entry.resource, &handle, &offset, &layout);
+    } else {
+      result = interop->lpVtbl->GetVulkanResourceInfo(
+          interop, entry.resource, &handle, &offset);
+    }
+    Log("transport_probe resource=%s hr=0x%08x vk_handle=0x%llx offset=%llu layout=%d",
+        entry.name, result, static_cast<unsigned long long>(handle),
+        static_cast<unsigned long long>(offset), layout);
+  }
+  interop->lpVtbl->Release(interop);
+}
