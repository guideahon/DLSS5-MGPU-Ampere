+static HRESULT STDMETHODCALLTYPE d3d12_dxvk_interop_device_GetCommandListQueue(
+        d3d12_dxvk_interop_device_iface *iface, ID3D12CommandList *command_list,
+        ID3D12CommandQueue **queue)
+{
+    struct d3d12_command_list *list;
+
+    (void)iface;
+    if (!command_list || !queue)
+        return E_INVALIDARG;
+    *queue = NULL;
+
+    list = d3d12_command_list_from_iface(command_list);
+    if (!list || !list->last_submit_queue)
+        return E_PENDING;
+
+    ID3D12CommandQueue_AddRef(&list->last_submit_queue->ID3D12CommandQueue_iface);
+    *queue = &list->last_submit_queue->ID3D12CommandQueue_iface;
+    return S_OK;
+}
