+                    NULL, &allocation->device_allocation.vk_memory));
+            fprintf(stderr, "VKD3D external fd direct vkAllocateMemory result=%d size=%"PRIu64" type=%u\n",
+                    vr, external_allocate_info.allocationSize, external_memory_type);
+            if (vr != VK_SUCCESS)
@@ -4458 +4504 @@
-                hr = E_NOTIMPL;
+                hr = hresult_from_vk_result(vr);
@@ -4461 +4507,6 @@
-#endif
+            allocation->device_allocation.vk_memory_type = external_memory_type;
+            allocation->device_allocation.size = external_allocate_info.allocationSize;
+            allocation->offset = 0;
+            allocation->heap_type = D3D12_HEAP_TYPE_DEFAULT;
+            allocation->resource.cookie = vkd3d_allocate_cookie();
+            allocation->resource.size = external_allocate_info.allocationSize;
@@ -4463,3 +4514 @@
-
-        /* Requires implies that prefers is also set by spec. */
-        if (dedicated_requirements.prefersDedicatedAllocation)
+        else if (dedicated_requirements.prefersDedicatedAllocation)
@@ -4496 +4545,6 @@
-        if (FAILED(hr = vkd3d_allocate_memory(device, &device->memory_allocator, &allocate_info, allocation)))
+        if (!external_fd_import &&
+                FAILED(hr = vkd3d_allocate_memory(device, &device->memory_allocator, &allocate_info, allocation)))
+        {
+            fprintf(stderr, "VKD3D external fd vkAllocateMemory failed hr=%#x req_size=%"PRIu64" type_bits=%#x pNext=%p\n",
+                    (int)hr, allocate_info.memory_requirements.size,
+                    allocate_info.memory_requirements.memoryTypeBits, allocate_info.pNext);
@@ -4497,0 +4552 @@
+        }
@@ -4509,0 +4565,2 @@
+            fprintf(stderr, "VKD3D external fd vkBindImageMemory2 failed vr=%d offset=%"PRIu64" memory=%p\n",
+                    vr, allocation->offset, allocation->device_allocation.vk_memory);
