+            VkMemoryAllocateInfo external_allocate_info;
+            uint32_t external_memory_type = UINT32_MAX;
+            uint32_t memory_type_bits = allocate_info.memory_requirements.memoryTypeBits;
+            uint32_t i;
+
+            for (i = 0; i < device->memory_properties.memoryTypeCount; ++i)
+            {
+                if ((memory_type_bits & (1u << i)) &&
+                        (device->memory_properties.memoryTypes[i].propertyFlags &
+                        VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT))
+                {
+                    external_memory_type = i;
+                    break;
+                }
+            }
+            if (external_memory_type == UINT32_MAX)
+                external_memory_type = vkd3d_bitmask_tzcnt32(memory_type_bits);
+            if (external_memory_type >= device->memory_properties.memoryTypeCount)
@@ -4450,5 +4489,2 @@
