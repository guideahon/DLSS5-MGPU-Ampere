+bool GpuNativeQueueProbeEnabled() {
+  char value[8]{};
+  const DWORD length = GetEnvironmentVariableA("MGPU_DLSSNR_GPU_NATIVE_QUEUE_PROBE",
+                                               value, static_cast<DWORD>(sizeof(value)));
+  return length > 0 && _stricmp(value, "1") == 0;
+}
+
+void ProbeGpuNativeCommandQueue(FeatureState& state,
+                                ID3D12GraphicsCommandList* commands) {
+  if (!GpuNativeQueueProbeEnabled() || state.gpu_native_queue_probe_done ||
+      !device || !commands)
+    return;
+  state.gpu_native_queue_probe_done = true;
+  Vkd3dInterop7* interop = nullptr;
+  const HRESULT query = device->QueryInterface(
+      kVkd3dInteropDevice7, reinterpret_cast<void**>(&interop));
+  if (FAILED(query) || interop == nullptr) {
+    state.gpu_native_queue_probe_result = query;
+    Log("gpu_native_command_list_queue_probe query=0x%08x", query);
+    return;
+  }
+  ID3D12CommandQueue* queue = nullptr;
+  state.gpu_native_queue_probe_result = interop->lpVtbl->GetCommandListQueue(
+      reinterpret_cast<Vkd3dInteropDevice*>(interop),
+      reinterpret_cast<ID3D12CommandList*>(commands), &queue);
+  if (SUCCEEDED(state.gpu_native_queue_probe_result) && queue != nullptr)
+    state.observed_command_queue.Attach(queue);
+  Log("gpu_native_command_list_queue_probe result=0x%08x queue=%p",
+      state.gpu_native_queue_probe_result, state.observed_command_queue.Get());
+  interop->lpVtbl->Release(reinterpret_cast<Vkd3dInteropDevice*>(interop));
+}
